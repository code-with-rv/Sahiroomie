# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PUBLIC_APP_URL: Canonical base URL where this app is hosted (prevents Host header poisoning).
# AI Studio automatically injects APP_URL at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
PUBLIC_APP_URL=""

# Optional Server-Side Firebase Config (read only by Express /api/firebase-config, never bundled into dist/)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_DATABASE_ID="(default)"
