{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public roommate seeker or host profile including photo, vibe preferences, and room requirements.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 200000 },
        "occupation": { "type": "string", "minLength": 0, "maxLength": 80 },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other", "Any"] },
        "city": { "type": "string", "minLength": 2, "maxLength": 60 },
        "state": { "type": "string", "minLength": 2, "maxLength": 60 },
        "bio": { "type": "string", "minLength": 0, "maxLength": 400 },
        "sleepVibe": { "type": "string", "enum": ["Early Bird", "Night Owl", "Flexible"] },
        "socialBattery": { "type": "string", "enum": ["Introvert", "Ambivert", "Extrovert"] },
        "cleanlinessVibe": { "type": "string", "enum": ["Pinterest Clean", "Organized Chaos", "Chill"] },
        "vibeTags": { "type": "array", "description": "Up to 8 Gen-Z vibe tags" },
        "roomRequirement": { "type": "object", "description": "Target city, area, budget, move-in timeline, and flatmate preferences" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "city", "state", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-only PII and KYC status strictly isolated from public reads.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 0, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 0, "maxLength": 24 },
        "age": { "type": "number" },
        "phoneVerified": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "idVerified": { "type": "boolean" },
        "kycBadgeToken": { "type": "string", "minLength": 0, "maxLength": 40 },
        "privacyExactArea": { "type": "boolean" },
        "privacyShowAge": { "type": "boolean" },
        "savedListingIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "age", "phoneVerified", "createdAt", "updatedAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Verified room, PG bed, or flatmate listing with 1 km privacy coordinates.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 4, "maxLength": 140 },
        "type": { "type": "string", "enum": ["Room in a flat", "PG", "Flat", "Roommate"] },
        "city": { "type": "string", "minLength": 2, "maxLength": 60 },
        "state": { "type": "string", "minLength": 2, "maxLength": 60 },
        "area": { "type": "string", "minLength": 2, "maxLength": 80 },
        "rent": { "type": "number" },
        "deposit": { "type": "number" },
        "sizeSqFt": { "type": "number" },
        "gender": { "type": "string", "enum": ["Any", "Male", "Female", "Other"] },
        "urgentDays": { "type": "number" },
        "photos": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "filled", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "type", "city", "area", "rent", "gender", "status", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Direct inquiry thread between two participants.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "initiatorId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hostId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "participantIds": { "type": "array" },
        "status": { "type": "string", "enum": ["open", "blocked"] },
        "lastMessageText": { "type": "string", "minLength": 0, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listingId", "initiatorId", "hostId", "participantIds", "status", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message sent within a chat thread.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    },
    "SafetyReport": {
      "title": "SafetyReport",
      "description": "Safety or scam moderation report.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "minLength": 2, "maxLength": 40 },
        "targetName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 200 },
        "status": { "type": "string", "enum": ["Pending", "Approved / Verified", "Banned & Removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetName", "reason", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/public/profile": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public roommate profile, photo, lifestyle vibe, and room requirement"
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII (email, phone, age, KYC badge, saved listing IDs)"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Room, PG, and roommate listings"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Direct inquiry threads between seekers and hosts"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual messages inside a chat thread"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/SafetyReport" },
      "description": "User-submitted moderation & scam reports"
    }
  }
}
